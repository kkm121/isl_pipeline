FROM python:3.12-slim

LABEL purpose="sealed-sandbox"
LABEL network="none"

WORKDIR /workspace

# Install system libraries for headless CV/MediaPipe runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install testing, linting, and CPU ML dependencies
COPY pyproject.toml .
RUN pip install --no-cache-dir pytest mypy ruff numpy pandas scikit-learn pyyaml types-PyYAML fastmcp opencv-python-headless
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu

# Copy source and tests
COPY src/ src/
COPY tests/ tests/
COPY configs/ configs/
COPY kaggle/ kaggle/
COPY mcp_servers/ mcp_servers/
COPY scripts/ scripts/

RUN pip install --no-cache-dir -e .

# Sealed Execution Boundary:
# Always executed with: --network=none --read-only --tmpfs /tmp --security-opt no-new-privileges
ENTRYPOINT ["python", "-m"]
CMD ["pytest", "tests/", "-v"]
