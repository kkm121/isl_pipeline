FROM python:3.11-slim

LABEL purpose="remote-integration-runner"
LABEL network="standard-bridge"

WORKDIR /workspace

# Install integration tools
RUN pip install --no-cache-dir kaggle gh

COPY pyproject.toml .
RUN pip install --no-cache-dir -e .

# Copy source and Kaggle tools
COPY src/ src/
COPY kaggle/ kaggle/
COPY scripts/ scripts/

# Security Notice:
# Credentials are NEVER mounted into or baked into this image.
# Authenticated operations flow strictly through the host-side AccountBroker.

ENTRYPOINT ["/bin/bash"]
